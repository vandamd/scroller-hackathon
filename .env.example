# Public configuration: both URLs must belong to the same development deployment.
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_SITE_URL=http://localhost:3000

# Private values for the web server and/or Bun worker. Never prefix with VITE_.
OPENAI_API_KEY=
WORKER_SECRET=
# Base64-encoded random 32-byte AES key, shared by the web server and worker.
X_SESSION_ENCRYPTION_KEY=

# Optional development deploy key if CLI account login is unavailable.
# CONVEX_DEPLOY_KEY=
# Optional path to Chrome/Chromium for the unofficial X password client.
# EMUSKS_CHROME_PATH=

# Configure these on the Convex development deployment:
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<random secret, at least 32 bytes>
# GOOGLE_CLIENT_ID=<Google web client ID>
# GOOGLE_CLIENT_SECRET=<Google web client secret>
# WORKER_SECRET=<same value as above>
